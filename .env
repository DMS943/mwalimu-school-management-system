# Mwalimu School Management System - Development Environment

# =================
# ENVIRONMENT SETUP
# =================
ENVIRONMENT=development
DEBUG=True

# =================
# SECURITY SETTINGS
# =================
SECRET_KEY=dev-key-mwalimu-school-2024-change-in-production-12345
DEBUG=True

# =================
# DATABASE SETTINGS (SQLite for Development)
# =================
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# =================
# ALLOWED HOSTS
# =================
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# =================
# CORS SETTINGS
# =================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:8000

# =================
# JWT SETTINGS
# =================
JWT_ACCESS_TOKEN_HOURS=24
JWT_REFRESH_TOKEN_DAYS=7

# =================
# EMAIL SETTINGS
# =================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@mwalimu-school.local

# =================
# CACHE SETTINGS (Memory Cache for Development)
# =================
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# =================
# TIMEZONE
# =================
TIME_ZONE=Africa/Lusaka

# =================
# DEVELOPMENT OPTIONS
# =================
ENABLE_DEBUG_TOOLBAR=True
ENABLE_SILK_PROFILER=False

# =================
# LOGGING
# =================
LOG_LEVEL=INFO