# Production Environment Variables

# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-at-least-50-characters-long-replace-this-immediately
ALLOWED_HOSTS=localhost,127.0.0.1,yourschool.com,www.yourschool.com
CORS_ALLOWED_ORIGINS=https://yourschool.com,https://www.yourschool.com,http://localhost:3000

# Database Configuration (Docker Compose)
DATABASE_NAME=school_management
DATABASE_USER=school_admin
DATABASE_PASSWORD=your-secure-database-password-123
DATABASE_HOST=postgres
DATABASE_PORT=5432

# Email Configuration (Optional - for notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-password

# Security Settings (Optional - enable for HTTPS)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY

# Deployment Settings (for non-Docker deployments)
# PRODUCTION_PATH=/var/www/school-management
# PRODUCTION_SERVER=your-server-ip
# PRODUCTION_USER=deploy

# File Storage (Optional - for AWS S3)
# USE_S3=False
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name

# Error Tracking (Optional - Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
