# Production Environment Configuration for Mwalimu School Management System
# This file contains production-specific environment variables

# =================
# ENVIRONMENT SETUP
# =================
ENVIRONMENT=production

# =================
# SECURITY SETTINGS
# =================
SECRET_KEY=YOUR-PRODUCTION-SECRET-KEY-MINIMUM-50-CHARACTERS-LONG
DEBUG=False

# =================
# DATABASE SETTINGS (Supabase)
# =================
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR-SUPABASE-PASSWORD
DATABASE_HOST=your-project.supabase.co
DATABASE_PORT=5432

# =================
# ALLOWED HOSTS (Production Domains)
# =================
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# =================
# CORS SETTINGS (Production Frontend URLs)
# =================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =================
# JWT SETTINGS (Production - Shorter Tokens)
# =================
JWT_ACCESS_TOKEN_HOURS=1
JWT_REFRESH_TOKEN_DAYS=7

# =================
# EMAIL SETTINGS (Production SMTP)
# =================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# =================
# CACHE SETTINGS (Production Redis)
# =================
REDIS_URL=redis://your-redis-host:6379/0

# =================
# TIMEZONE
# =================
TIME_ZONE=Africa/Lusaka

# =================
# MONITORING & LOGGING
# =================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
RELEASE_VERSION=1.0.0
ENABLE_MONITORING=True

# =================
# PERFORMANCE OPTIMIZATION & CACHING
# =================
# Enhanced Caching Configuration
REDIS_URL=redis://your-redis-host:6379/0
REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379,sentinel3:26379
REDIS_SENTINEL_SERVICE=mwalimu-redis

# Multi-layer Cache Settings  
CACHE_WARMING_ENABLED=True
QUERY_OPTIMIZATION_ENABLED=True
SLOW_QUERY_THRESHOLD=0.1
SLOW_RESPONSE_THRESHOLD=2.0
MAX_QUERIES_PER_REQUEST=50
N_PLUS_ONE_DETECTION=True
AUTO_PREFETCH_ENABLED=True

# CDN and Asset Optimization
CDN_ENABLED=True
CDN_DOMAIN=cdn.yourschool.com
AWS_S3_CDN_BUCKET=mwalimu-school-cdn
CLOUDFLARE_ENABLED=True
ASSET_OPTIMIZATION_ENABLED=True
COMPRESS_ENABLED=True
COMPRESS_OFFLINE=True

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=True
PERFORMANCE_DASHBOARD_ENABLED=True
QUERY_TRACKING_ENABLED=False
CACHE_METRICS_ENABLED=True

# =================
# DISASTER RECOVERY & ADVANCED BACKUP
# =================
# Enhanced Backup Configuration
BACKUP_DIR=/opt/backups
BACKUP_ENCRYPTION_KEY=your-strong-encryption-key-here-minimum-32-chars
S3_BACKUP_BUCKET=mwalimu-school-backups
GLACIER_VAULT=mwalimu-school-archive

# Multi-tier Backup Settings
BACKUP_LOCAL_RETENTION_DAYS=7
BACKUP_REGIONAL_RETENTION_DAYS=30
BACKUP_OFFSITE_RETENTION_DAYS=90
BACKUP_ARCHIVE_RETENTION_YEARS=7

# Recovery Objectives (in minutes)
DATABASE_RTO=15
DATABASE_RPO=5
APPLICATION_RTO=30
APPLICATION_RPO=15

# Disaster Recovery Monitoring
DR_MONITORING_ENABLED=True
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
BACKUP_ALERT_EMAILS=admin@yourschool.com,it-team@yourschool.com
BACKUP_ALERT_SMS=+1234567890

# Compliance Settings
COMPLIANCE_STANDARDS=FERPA,GDPR,SOX,ISO27001
AUDIT_LOGGING_ENABLED=True
DATA_RETENTION_AUDIT=True

# =================
# BACKUP SETTINGS
# =================
BACKUP_DIR=/opt/backups
BACKUP_S3_ENABLED=True
BACKUP_RETENTION_DAYS=90
S3_BACKUP_BUCKET=mwalimu-school-backups

# AWS Settings for S3 backup
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# =================
# SSL & SECURITY
# =================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000