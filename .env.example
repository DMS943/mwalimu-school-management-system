# Environment Configuration for Mwalimu School Management System
# Copy this file to .env and fill in your specific values

# =================
# ENVIRONMENT SETUP
# =================
ENVIRONMENT=development  # development, staging, production

# =================
# SECURITY SETTINGS
# =================
SECRET_KEY=your-super-secret-django-key-here-change-in-production
DEBUG=True

# =================
# DATABASE SETTINGS
# =================
DATABASE_NAME=school_management
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# For Supabase (comment out above and use these):
# DATABASE_NAME=postgres
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your-supabase-password
# DATABASE_HOST=your-project.supabase.co
# DATABASE_PORT=5432

# =================
# ALLOWED HOSTS
# =================
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# =================
# CORS SETTINGS
# =================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# =================
# JWT SETTINGS
# =================
JWT_ACCESS_TOKEN_HOURS=1
JWT_REFRESH_TOKEN_DAYS=7

# =================
# EMAIL SETTINGS
# =================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@school.com

# =================
# CACHE SETTINGS
# =================
REDIS_URL=redis://127.0.0.1:6379/1

# =================
# TIMEZONE
# =================
TIME_ZONE=Africa/Lusaka

# =================
# MONITORING & LOGGING (Production)
# =================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RELEASE_VERSION=1.0.0

# =================
# BACKUP SETTINGS
# =================
BACKUP_DIR=/opt/backups
BACKUP_S3_ENABLED=False
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=your-backup-bucket

# AWS Settings for S3 backup (if enabled)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# =================
# SSL & SECURITY (Production)
# =================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# =================
# DEVELOPMENT OPTIONS
# =================
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SILK_PROFILER=False