# Staging Environment Configuration for Mwalimu School Management System
# This file contains staging-specific environment variables

# =================
# ENVIRONMENT SETUP
# =================
ENVIRONMENT=staging

# =================
# SECURITY SETTINGS
# =================
SECRET_KEY=YOUR-STAGING-SECRET-KEY-MINIMUM-50-CHARACTERS-LONG
DEBUG=False

# =================
# DATABASE SETTINGS (Staging Supabase)
# =================
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR-STAGING-SUPABASE-PASSWORD
DATABASE_HOST=your-staging-project.supabase.co
DATABASE_PORT=5432

# =================
# ALLOWED HOSTS (Staging Domains)
# =================
ALLOWED_HOSTS=staging.yourdomain.com,api-staging.yourdomain.com,localhost

# =================
# CORS SETTINGS (Staging Frontend URLs)
# =================
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,http://localhost:3000

# =================
# JWT SETTINGS (Staging - Longer Tokens for Testing)
# =================
JWT_ACCESS_TOKEN_HOURS=4
JWT_REFRESH_TOKEN_DAYS=14

# =================
# EMAIL SETTINGS (Staging - Console or Test SMTP)
# =================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=staging@yourdomain.com

# =================
# CACHE SETTINGS (Staging Redis)
# =================
REDIS_URL=redis://your-staging-redis:6379/0

# =================
# TIMEZONE
# =================
TIME_ZONE=Africa/Lusaka

# =================
# MONITORING & LOGGING (Optional for Staging)
# =================
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
RELEASE_VERSION=staging

# =================
# SSL & SECURITY (Relaxed for Staging)
# =================
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# =================
# STAGING DEBUG OPTIONS
# =================
ENABLE_STAGING_DEBUG=False