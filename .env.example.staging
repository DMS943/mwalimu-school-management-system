# Staging Environment Variables

# Django Settings
DEBUG=True
SECRET_KEY=staging-secret-key
ALLOWED_HOSTS=staging.yourschool.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://staging.yourschool.com

# Database
DATABASE_NAME=school_management_staging
DATABASE_USER=school_admin
DATABASE_PASSWORD=staging-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Email (use console backend for staging)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Deployment
STAGING_PATH=/var/www/school-management-staging
STAGING_SERVER=staging-server-ip
STAGING_USER=deploy
